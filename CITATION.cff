  - family-names: Malo
    given-names: Ripon Chandra
    affiliation: University of Utah
version: 0.4.0
license: MIT
repository-code: "https://github.com/bigfree/dejafix"
url: "https://github.com/bigfree/dejafix"
keywords:
  - coding agent memory
  - memory for AI coding agents
  - AI coding agents
  - model context protocol
  - local-first
